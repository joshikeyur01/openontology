    {
      "type": "timeseries",
      "id": 31,
      "title": "Irreversible actions, and the guardrails that stopped them",
      "description": "The safety property this layer rests on. Guardrails run after the planner, so neither a model error nor a prompt injection can route around them \u2014 a downgrade appearing here is the system refusing to shut down an asset on a topology it does not trust.",
      "datasource": {
        "type": "prometheus",
        "uid": "openontology-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 45
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reversible) (rate(openontology_graphrag_actions_issued_total[$rate_window]))",
          "legendFormat": "reversible={{reversible}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(openontology_graphrag_guardrails_applied_total[$rate_window])) or vector(0)",
          "legendFormat": "guardrails fired"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
