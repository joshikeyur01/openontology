    {
      "type": "timeseries",
      "id": 24,
      "title": "Commands issued, by action",
      "description": "What the system actually told operators to do. The severity of the action mix is the outcome the whole pipeline exists to produce \u2014 ISOLATE and SHUTDOWN against a live asset are not the same event as INSPECT and NOTIFY.",
      "datasource": {
        "type": "prometheus",
        "uid": "openontology-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(openontology_worker_commands_by_action_total[$rate_window]))",
