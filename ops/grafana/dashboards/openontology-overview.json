        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "replays (inference avoided)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
