          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 26,
      "title": "Dead-letter topics",
      "description": "Depth of telemetry.dlq and ontology.commands.dlq, from broker offsets. Poison pills are committed rather than retried forever, so a rising line here is a class of malformed input or a terminal licence failure \u2014 not a stuck partition.",
      "datasource": {
        "type": "prometheus",
        "uid": "openontology-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 37
