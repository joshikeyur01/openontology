    {
      "type": "timeseries",
      "id": 25,
      "title": "Idempotency: inferences avoided",
      "description": "Kafka delivers at least once, so the same mutation reaches the planner more than once as a matter of routine. Every replay here is an inference that was not paid for and a second ISOLATE that was not issued against a live asset.",
      "datasource": {
        "type": "prometheus",
        "uid": "openontology-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(openontology_interceptor_plans_issued_total[$rate_window]))",
          "legendFormat": "plans issued (inference paid)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(openontology_interceptor_plan_replays_total[$rate_window])) or vector(0)",
          "legendFormat": "replays (inference avoided)"
        },
        {
          "refId": "C",
          "expr": "sum(rate(openontology_events_duplicate_total[$rate_window]))",
          "legendFormat": "duplicates dropped at ingestion"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
