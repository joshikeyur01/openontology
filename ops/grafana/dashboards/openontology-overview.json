    {
      "type": "timeseries",
      "id": 23,
      "title": "Interceptor call outcomes, by fault",
      "description": "As the closure loop experienced them. ok is a plan returned; throttled means the worker outran its learned pace; auth_failure and payload_rejected are terminal and dead-letter immediately, while timeout and server_error are retried with backoff.",
      "datasource": {
        "type": "prometheus",
        "uid": "openontology-prometheus"
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 30
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cause) (rate(openontology_worker_interceptor_calls_total[$rate_window]))",
          "legendFormat": "{{cause}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 50,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ok"
