# Copy to .env; docker compose reads it automatically.

# Image tag stamped into the Go binary via -ldflags.
OO_VERSION=1.0.0

# --- Graph tier -------------------------------------------------------------
# neo4j : resolve ontology context out of the live topology graph (compose
#         default; the seeded fixtures live in ops/neo4j/*.cypher)
# mock  : fixture-backed stand-in, no server required — this is what the Go
#         binary itself defaults to, so `go run .` needs no Neo4j
GRAPH_PROVIDER=neo4j
NEO4J_PASSWORD=openontology

# --- Commercial AI layer ----------------------------------------------------
# The planner is provider-agnostic: it needs a tool-calling LLM API and nothing
# more. Which one is a config choice, not a code change.
# mock  : deterministic in-process planner, no network, no API key (default)
# cloud : live provider call through services/ai-interceptor/app/llm_cloud.py
OO_LLM_PROVIDER=mock
OO_LLM_EFFORT=medium
# Required when OO_LLM_PROVIDER=cloud: the id of a model your provider serves.
# Left unset, the service reports the offline planner's own id and refuses to
# start in cloud mode rather than guess a model for you.
# OO_LLM_MODEL=
# OO_LLM_API_KEY=

# Demo subscription keys served by the built-in registry:
#   oo-live-enterprise-demo-key  ENTERPRISE  600 rpm  ai.intercept + ai.autopilot
#   oo-live-standard-demo-key    STANDARD     60 rpm  ai.intercept
#   oo-live-community-demo-key   COMMUNITY    10 rpm  no ai.intercept -> 403
#   oo-live-expired-demo-key     STANDARD     expired -> 402
# Point OO_LICENSE_REGISTRY_PATH at a JSON file to replace them. The command
# worker reads the same file and accepts either "tier" or "plan" as the field
# name, so one billing export feeds both services.
# OO_LICENSE_REGISTRY_PATH=/app/licenses.json

# --- Closure loop (ontology.mutations -> ontology.commands) ------------------
# http : the command worker plans through the commercial interceptor over HTTP
#        (compose default; this is the product)
# stub : in-process simulator, no interceptor and no network — offline work
OO_INTERCEPTOR_MODE=http

# The subscription the closure loop runs under. Engine-produced Kafka records
# carry no credential of their own, so the worker presents this one. Its tier
# governs both halves: STANDARD plans every command with requires_human_approval
# set, ENTERPRISE is the only tier that may act without a human ack.
OO_COMMAND_LICENSE_KEY=oo-live-standard-demo-key

# --- Enterprise tier: the GraphRAG two-agent planner ------------------------
# deterministic : the offline two-agent loop, no network and no API key
# cloud         : live provider calls for both agents
OO_GRAPHRAG_AGENT_PROVIDER=deterministic
# Required when OO_GRAPHRAG_AGENT_PROVIDER=cloud.
# OO_GRAPHRAG_AGENT_MODEL=
# OO_GRAPHRAG_AGENT_API_KEY=

# The subscription the closure loop presents to the GraphRAG planner. It is a
# separate subscription from OO_COMMAND_LICENSE_KEY above, so the credential
# travels with the endpoint: a mutation routed to the enterprise planner
# presents this key, everything else presents the standard one.
#   oo-live-graphrag-enterprise-key  ENTERPRISE  600 rpm  graphrag + autopilot
#   oo-live-graphrag-business-key    BUSINESS     60 rpm  graphrag
#   oo-live-graphrag-community-key   COMMUNITY    10 rpm  no graphrag -> 403
#   oo-live-graphrag-lapsed-key      BUSINESS     expired -> 402
OO_GRAPHRAG_LICENSE_KEY=oo-live-graphrag-enterprise-key

# Interceptor call ceiling, requests/minute. 0 means "learn it" — the worker
# reads quota_per_minute off /v1/license at boot and paces to 90% of it, which
# is why healthy traffic never manufactures a 429. Set a number to override.
OO_INTERCEPTOR_MAX_RPM=0
